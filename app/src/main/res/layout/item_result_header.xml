<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_horizontal"
    android:orientation="vertical">

    <FrameLayout
        android:id="@+id/ring_glow"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="?attr/colorSurfaceContainerLow">

        <net.golbarg.skillassessment.ui.widget.ScoreRingView
            android:id="@+id/ring"
            android:layout_width="184dp"
            android:layout_height="184dp"
            android:layout_gravity="center" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txt_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Display"
                android:textColor="?attr/colorOnSurface"
                android:textSize="44sp"
                tools:text="80%" />

            <TextView
                android:id="@+id/txt_ratio"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.App.Caption"
                tools:text="8 / 10" />
        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/txt_headline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:textAppearance="@style/TextAppearance.App.Headline"
        android:textColor="?attr/colorOnSurface"
        tools:text="Great job!" />

    <TextView
        android:id="@+id/txt_summary"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.App.Caption"
        tools:text="You answered 8 of 10 correctly" />

    <LinearLayout
        android:id="@+id/streak_badge"
        android:layout_width="wrap_content"
        android:layout_height="32dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_pill"
        android:backgroundTint="@color/coin_container"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_flame" />

        <TextView
            android:id="@+id/txt_best_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="@color/on_coin_container"
            tools:text="Best streak: 5" />
    </LinearLayout>

    <!-- Daily bonus, day streak and newly unlocked achievements -->
    <LinearLayout
        android:id="@+id/extras"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <include
            android:id="@+id/stat_correct"
            layout="@layout/view_stat_tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/stat_wrong"
            layout="@layout/view_stat_tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/stat_skipped"
            layout="@layout/view_stat_tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />

        <include
            android:id="@+id/stat_time"
            layout="@layout/view_stat_tile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_retry"
            style="@style/Widget.App.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:text="@string/try_again"
            app:icon="@drawable/ic_replay"
            app:iconGravity="textStart" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_done"
            style="@style/Widget.App.Button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/back_home" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_practice_mistakes"
        style="@style/Widget.App.Button.Outlined"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/practice_mistakes"
        android:visibility="gone"
        app:icon="@drawable/ic_replay"
        app:iconGravity="textStart"
        tools:visibility="visible" />

    <TextView
        android:id="@+id/txt_review_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="2dp"
        android:text="@string/review_answers"
        android:textAppearance="@style/TextAppearance.App.Title"
        android:textColor="?attr/colorOnSurface" />
</LinearLayout>
