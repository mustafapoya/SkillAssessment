<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="8dp">

    <!-- Unfinished test, shown above everything else. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_resume"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/list_gap"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSecondaryContainer"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="8dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_play_circle"
                app:tint="?attr/colorOnSecondaryContainer" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/resume_title"
                    android:textAppearance="@style/TextAppearance.App.Subtitle"
                    android:textColor="?attr/colorOnSecondaryContainer" />

                <TextView
                    android:id="@+id/txt_resume_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    tools:text="Python · 4 of 10 answered" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_resume"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/resume_continue" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_resume_discard"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/resume_discard"
                app:icon="@drawable/ic_close"
                app:iconTint="?attr/colorOnSecondaryContainer" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- A streak that ended yesterday and can still be saved. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_streak_restore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/list_gap"
        android:visibility="gone"
        app:cardBackgroundColor="@color/coin_container"
        tools:visibility="visible">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="14dp">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_flame" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/txt_streak_restore_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.App.Subtitle"
                    android:textColor="@color/on_coin_container"
                    tools:text="Save your 6-day streak" />

                <TextView
                    android:id="@+id/txt_streak_restore_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    android:textColor="@color/on_coin_container"
                    tools:text="You missed yesterday. Watch a short video to keep your streak going." />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_streak_restore"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="@string/streak_restore_button" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Today: goal ring plus the three headline stats, in one hero. Tap to change the goal. -->
    <LinearLayout
        android:id="@+id/card_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero"
        android:baselineAligned="false"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_goal"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:importantForAccessibility="no"
                app:indicatorColor="@android:color/white"
                app:indicatorInset="0dp"
                app:indicatorSize="72dp"
                app:trackColor="#33FFFFFF"
                app:trackCornerRadius="3dp"
                app:trackThickness="6dp"
                tools:progress="40" />

            <ImageView
                android:id="@+id/img_goal"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_flag"
                app:tint="@android:color/white" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:alpha="0.85"
                    android:text="@string/daily_goal"
                    android:textAllCaps="true"
                    android:textAppearance="@style/TextAppearance.App.Overline"
                    android:textColor="@android:color/white" />

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:alpha="0.8"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_edit"
                    app:tint="@android:color/white" />
            </LinearLayout>

            <TextView
                android:id="@+id/txt_goal_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.App.Subtitle"
                android:textColor="@android:color/white"
                tools:text="7 of 20 questions today" />

            <!-- Headline stats, compact: value over label. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_stat_tests"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        tools:text="12" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:text="@string/stat_tests"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_stat_accuracy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        tools:text="78%" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:text="@string/stat_accuracy"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@android:color/white" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txt_stat_topics"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="@android:color/white"
                        android:textStyle="bold"
                        tools:text="3/58" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.8"
                        android:text="@string/stat_topics"
                        android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                        android:textColor="@android:color/white" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Daily challenge: one slim row. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_daily"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/list_gap"
        android:clickable="true"
        android:focusable="true"
        app:cardBackgroundColor="?attr/colorPrimaryContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="64dp"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <FrameLayout
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="?attr/colorPrimary">

                <ImageView
                    android:id="@+id/img_daily"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_today"
                    app:tint="?attr/colorOnPrimary" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="8dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/daily_challenge"
                    android:textAppearance="@style/TextAppearance.App.Subtitle"
                    android:textColor="?attr/colorOnPrimaryContainer" />

                <TextView
                    android:id="@+id/txt_daily_desc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    tools:text="5 mixed questions · +1 coin" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_daily"
                style="@style/Widget.Material3.Button"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:text="@string/start" />

            <ImageView
                android:id="@+id/img_daily_done"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_check_circle"
                android:visibility="gone"
                app:tint="?attr/colorPrimary" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Practice modes: compact two-column tiles. -->
    <TextView
        style="@style/Widget.App.HomeSection"
        android:text="@string/section_practice" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_review"
            style="@style/Widget.App.HomeTile"
            android:layout_marginEnd="5dp">

            <LinearLayout style="@style/Widget.App.HomeTile.Content">

                <FrameLayout style="@style/Widget.App.HomeTile.IconBox">

                    <ImageView
                        android:importantForAccessibility="no"
                        style="@style/Widget.App.HomeTile.Icon"
                        android:src="@drawable/ic_replay" />
                </FrameLayout>

                <LinearLayout style="@style/Widget.App.HomeTile.Texts">

                    <TextView
                        style="@style/Widget.App.HomeTile.Title"
                        android:text="@string/mistakes_review" />

                    <TextView
                        android:id="@+id/txt_review_desc"
                        style="@style/Widget.App.HomeTile.Desc"
                        tools:text="9 to review" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_mixed"
            style="@style/Widget.App.HomeTile"
            android:layout_marginStart="5dp">

            <LinearLayout style="@style/Widget.App.HomeTile.Content">

                <FrameLayout style="@style/Widget.App.HomeTile.IconBox">

                    <ImageView
                        android:importantForAccessibility="no"
                        style="@style/Widget.App.HomeTile.Icon"
                        android:src="@drawable/ic_shuffle" />
                </FrameLayout>

                <LinearLayout style="@style/Widget.App.HomeTile.Texts">

                    <TextView
                        style="@style/Widget.App.HomeTile.Title"
                        android:text="@string/mixed_practice" />

                    <TextView
                        android:id="@+id/txt_mixed_desc"
                        style="@style/Widget.App.HomeTile.Desc"
                        android:text="@string/mixed_practice_desc" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/list_gap"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_sprint"
            style="@style/Widget.App.HomeTile"
            android:layout_marginEnd="5dp">

            <LinearLayout style="@style/Widget.App.HomeTile.Content">

                <FrameLayout style="@style/Widget.App.HomeTile.IconBox">

                    <ImageView
                        android:importantForAccessibility="no"
                        style="@style/Widget.App.HomeTile.Icon"
                        android:src="@drawable/ic_timer" />
                </FrameLayout>

                <LinearLayout style="@style/Widget.App.HomeTile.Texts">

                    <TextView
                        style="@style/Widget.App.HomeTile.Title"
                        android:text="@string/speed_round" />

                    <TextView
                        android:id="@+id/txt_sprint_desc"
                        style="@style/Widget.App.HomeTile.Desc"
                        tools:text="60 seconds · best 12" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_interview"
            style="@style/Widget.App.HomeTile"
            android:layout_marginStart="5dp">

            <LinearLayout style="@style/Widget.App.HomeTile.Content">

                <FrameLayout style="@style/Widget.App.HomeTile.IconBox">

                    <ImageView
                        android:importantForAccessibility="no"
                        style="@style/Widget.App.HomeTile.Icon"
                        android:src="@drawable/ic_school" />
                </FrameLayout>

                <LinearLayout style="@style/Widget.App.HomeTile.Texts">

                    <TextView
                        style="@style/Widget.App.HomeTile.Title"
                        android:text="@string/interview_prep" />

                    <TextView
                        android:id="@+id/txt_interview_desc"
                        style="@style/Widget.App.HomeTile.Desc"
                        android:text="@string/interview_prep_desc" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Topics: dense search plus one scrollable row of filters. -->
    <TextView
        style="@style/Widget.App.HomeSection"
        android:text="@string/section_topics" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/layout_search"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/search_topics"
        app:boxBackgroundColor="?attr/colorSurfaceContainerLowest"
        app:boxCornerRadiusBottomEnd="24dp"
        app:boxCornerRadiusBottomStart="24dp"
        app:boxCornerRadiusTopEnd="24dp"
        app:boxCornerRadiusTopStart="24dp"
        app:boxStrokeColor="?attr/colorPrimary"
        app:endIconMode="clear_text"
        app:hintEnabled="false"
        app:startIconDrawable="@drawable/ic_search">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/edit_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/search_topics"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:maxLines="1" />
    </com.google.android.material.textfield.TextInputLayout>

    <HorizontalScrollView
        android:id="@+id/scroll_domains"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:fadingEdgeLength="32dp"
        android:requiresFadingEdge="horizontal"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Status is a dropdown chip so it doesn't need a row of its own. -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checkable="false"
                android:text="@string/filter_any_status"
                app:chipIcon="@drawable/ic_filter_list"
                app:chipIconVisible="true"
                app:closeIcon="@drawable/ic_arrow_drop_down"
                app:closeIconVisible="true" />

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/colorOutlineVariant" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chip_group_domain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedChip="@id/chip_domain_all"
                app:selectionRequired="true"
                app:singleLine="true"
                app:singleSelection="true">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_domain_all"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/domain_all" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_domain_languages"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/domain_languages" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_domain_frontend"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/domain_frontend" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_domain_backend"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/domain_backend" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_domain_mobile"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/domain_mobile" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_domain_databases"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/domain_databases" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_domain_cloud_devops"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/domain_cloud_devops" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_domain_ai_data"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/domain_ai_data" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chip_domain_tools"
                    style="@style/Widget.Material3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/domain_tools" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>
    </HorizontalScrollView>

    <TextView
        android:id="@+id/txt_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:paddingTop="48dp"
        android:paddingBottom="48dp"
        android:textAppearance="@style/TextAppearance.App.Caption"
        android:visibility="gone"
        tools:text="No topics match" />
</LinearLayout>
