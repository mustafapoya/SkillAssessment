<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="24dp"
        android:paddingEnd="16dp"
        android:paddingBottom="24dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:importantForAccessibility="no"
                android:src="@drawable/app_logo"
                app:shapeAppearance="@style/Shape.App.Card" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/app_name"
                android:textAppearance="@style/TextAppearance.App.Headline"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/txt_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textAppearance="@style/TextAppearance.App.Caption"
                tools:text="Version 2.0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:maxWidth="340dp"
                android:text="@string/app_desc"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_preferences"
            android:textAppearance="@style/TextAppearance.App.Overline" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_theme"
                    layout="@layout/view_setting_row" />

                <include
                    android:id="@+id/row_goal"
                    layout="@layout/view_setting_row" />

                <include
                    android:id="@+id/row_font_size"
                    layout="@layout/view_setting_switch_row" />

                <include
                    android:id="@+id/row_sound"
                    layout="@layout/view_setting_switch_row" />

                <include
                    android:id="@+id/row_vibration"
                    layout="@layout/view_setting_switch_row" />

                <include
                    android:id="@+id/row_reminder"
                    layout="@layout/view_setting_switch_row" />

                <!-- Only shown where privacy law requires a way to revisit ad consent. -->
                <include
                    android:id="@+id/row_privacy"
                    layout="@layout/view_setting_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hidden while Premium isn't on sale (BillingManager.FOR_SALE). -->
        <TextView
            android:id="@+id/txt_premium_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/premium"
            android:textAppearance="@style/TextAppearance.App.Overline" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_premium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_premium"
                    layout="@layout/view_setting_row" />

                <include
                    android:id="@+id/row_restore"
                    layout="@layout/view_setting_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_data"
            android:textAppearance="@style/TextAppearance.App.Overline" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_backup"
                    layout="@layout/view_setting_row" />

                <include
                    android:id="@+id/row_restore_backup"
                    layout="@layout/view_setting_row" />

                <include
                    android:id="@+id/row_content_updates"
                    layout="@layout/view_setting_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_support"
            android:textAppearance="@style/TextAppearance.App.Overline" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_rate"
                    layout="@layout/view_setting_row" />

                <include
                    android:id="@+id/row_share"
                    layout="@layout/view_setting_row" />

                <include
                    android:id="@+id/row_feedback"
                    layout="@layout/view_setting_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="8dp"
            android:text="@string/section_connect"
            android:textAppearance="@style/TextAppearance.App.Overline" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_website"
                    layout="@layout/view_setting_row" />

                <include
                    android:id="@+id/row_facebook"
                    layout="@layout/view_setting_row" />

                <include
                    android:id="@+id/row_youtube"
                    layout="@layout/view_setting_row" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:importantForAccessibility="no"
                android:src="@drawable/golbarg_logo_blue" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="@string/about_tagline"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_copyright"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?attr/colorOutline"
            tools:text="© 2026 Golbarg" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
